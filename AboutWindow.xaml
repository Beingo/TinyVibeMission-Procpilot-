<Window x:Class="ProcPilot.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于 ProcPilot"
        Height="600" Width="620"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource AppFont}"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Image x:Name="AppIcon" Width="44" Height="44" VerticalAlignment="Center"/>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="TxtTitle" Text="ProcPilot" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock x:Name="TxtTagline" Text="" FontSize="12" Margin="0,4,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </StackPanel>

        <!-- 基本信息 -->
        <Border Grid.Row="1" CornerRadius="8" Padding="14" Margin="0,0,0,12"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="运行信息" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock x:Name="TxtInfo" FontSize="12" LineHeight="20"
                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- 设计要点 -->
        <Border Grid.Row="2" CornerRadius="8" Padding="14"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="设计要点" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="TxtDesign" FontSize="12" LineHeight="21"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="打开配置目录" Width="120" Height="32" Margin="0,0,8,0" Click="OnOpenDataDir"
                    Style="{StaticResource StateButtonStyle}"
                    Background="{DynamicResource ButtonNormalBrush}"
                    Foreground="{DynamicResource ButtonNormalTextBrush}"/>
            <Button Content="复制诊断信息" Width="120" Height="32" Margin="0,0,8,0" Click="OnCopyInfo"
                    Style="{StaticResource StateButtonStyle}"
                    Background="{DynamicResource ButtonNormalBrush}"
                    Foreground="{DynamicResource ButtonNormalTextBrush}"/>
            <Button Content="关闭" Width="90" Height="32" Click="OnClose"
                    Style="{StaticResource StateButtonStyle}"
                    Background="{DynamicResource ButtonNormalBrush}"
                    Foreground="{DynamicResource ButtonNormalTextBrush}"/>
        </StackPanel>
    </Grid>
</Window>
