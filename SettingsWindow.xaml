<Window x:Class="ProcPilot.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置 — ProcPilot"
        Height="640" Width="660"
        MinHeight="480" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource AppFont}"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="18,14,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- ===== 自动规则 ===== -->
                <Border CornerRadius="8" Padding="14" Margin="0,0,0,12"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="进程记忆（自动应用优先级）" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ChkAutoRemember" Content="用户设置后自动记住（该进程每次启动时自动应用）"
                                  Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"
                                  Checked="OnSettingsChanged" Unchecked="OnSettingsChanged"/>
                        <CheckBox x:Name="ChkApplyRunning" Content="ProcPilot 启动时，对已在运行的进程也应用规则"
                                  Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"
                                  Checked="OnSettingsChanged" Unchecked="OnSettingsChanged"/>

                        <ListView x:Name="LvRules" Height="150" BorderThickness="1"
                                  BorderBrush="{DynamicResource BorderBrush}"
                                  Background="{DynamicResource AppBackgroundBrush}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="进程" Width="200" DisplayMemberBinding="{Binding Name}"/>
                                    <GridViewColumn Header="记住的状态" Width="150" DisplayMemberBinding="{Binding StateText}"/>
                                    <GridViewColumn Header="启用" Width="70" DisplayMemberBinding="{Binding EnabledText}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="启用/停用选中" Width="120" Height="30" Margin="0,0,8,0" Click="OnToggleRule"/>
                            <Button Content="删除选中" Width="90" Height="30" Margin="0,0,8,0" Click="OnDeleteRule"/>
                            <Button Content="清空全部" Width="90" Height="30" Click="OnClearRules"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===== 开机启动 ===== -->
                <Border CornerRadius="8" Padding="14" Margin="0,0,0,12"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="开机启动" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ChkAutoStart" Content="开机自启动（写入当前用户启动项，无需管理员）"
                                  Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"
                                  Checked="OnAutoStartChanged" Unchecked="OnAutoStartChanged"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <CheckBox x:Name="ChkRandomDelay" Content="自启动时随机延迟"
                                      Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                                      Checked="OnSettingsChanged" Unchecked="OnSettingsChanged"/>
                            <TextBox x:Name="TxtDelayMax" Width="60" Height="26" Margin="12,0,6,0"
                                     VerticalContentAlignment="Center" TextAlignment="Center"
                                     LostFocus="OnDelayMaxChanged" KeyDown="OnDelayMaxKeyDown"/>
                            <TextBlock Text="秒（实际 1 ~ 该值之间随机）" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <CheckBox x:Name="ChkStartHidden" Content="自启动时静默驻留托盘（不弹主窗口）"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  Checked="OnSettingsChanged" Unchecked="OnSettingsChanged"/>
                        <TextBlock x:Name="TxtAutoStartInfo" Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- ===== 后台与诊断 ===== -->
                <Border CornerRadius="8" Padding="14"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="后台与资源" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ChkPauseUnfocused" Content="窗口失去焦点时暂停采样（最省资源；否则降为 2s 慢采样）"
                                  Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"
                                  Checked="OnSettingsChanged" Unchecked="OnSettingsChanged"/>
                        <CheckBox x:Name="ChkDiag" Content="写诊断日志（排查问题时再开，平时关闭以减少磁盘 IO）"
                                  Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"
                                  Checked="OnSettingsChanged" Unchecked="OnSettingsChanged"/>
                        <TextBlock x:Name="TxtEngineInfo" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock x:Name="TxtDataDir" VerticalAlignment="Center" Margin="0,0,14,0" FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <Button Content="关于…" Width="90" Height="32" Margin="0,0,8,0" Click="OnAboutClick"
                    Style="{StaticResource StateButtonStyle}"
                    Background="{DynamicResource ButtonNormalBrush}"
                    Foreground="{DynamicResource ButtonNormalTextBrush}"/>
            <Button Content="关闭" Width="90" Height="32" Click="OnCloseClick"
                    Style="{StaticResource StateButtonStyle}"
                    Background="{DynamicResource ButtonNormalBrush}"
                    Foreground="{DynamicResource ButtonNormalTextBrush}"/>
        </StackPanel>
    </Grid>
</Window>
