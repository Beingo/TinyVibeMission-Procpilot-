<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 深色主题 -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#15171C"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1F232B"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E8EAEF"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9AA3B2"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#2E3440"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#2A2F3A"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#3A4A6B"/>
    <SolidColorBrush x:Key="ButtonNormalBrush" Color="#3A4150"/>
    <SolidColorBrush x:Key="ButtonNormalTextBrush" Color="#D8DCE4"/>
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#5A6270"/>

    <!-- 状态色（半透明以便深色底上柔和） -->
    <SolidColorBrush x:Key="StateBelowNormalBrush" Color="#407CC9F8"/>
    <SolidColorBrush x:Key="StateBelowNormalTextBrush" Color="#BFE2FF"/>
    <SolidColorBrush x:Key="StateTrimmedBrush" Color="#4D2E8BF0"/>
    <SolidColorBrush x:Key="StateTrimmedTextBrush" Color="#CFE4FF"/>
    <SolidColorBrush x:Key="StateFrozenBrush" Color="#408FE0A0"/>
    <SolidColorBrush x:Key="StateFrozenTextBrush" Color="#BFEED0"/>
</ResourceDictionary>
